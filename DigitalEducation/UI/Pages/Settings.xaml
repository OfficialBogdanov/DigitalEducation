<Window x:Class="DigitalEducation.UI.Pages.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:DigitalEducation.UI.Components"
        mc:Ignorable="d"
        Title="DigitalEducation — Настройки"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid>
        <components:Background x:Name="BackgroundControl"/>

        <Grid x:Name="ContentContainer">
            <Grid.Effect>
                <BlurEffect x:Name="ContentBlur"
                            Radius="0"
                            KernelType="Gaussian"/>
            </Grid.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Margin="400,0,400,0">

                <StackPanel Margin="0,100,0,0">

                    <StackPanel Margin="0,0,0,32">
                        <TextBlock Text="Персонализация"
                                   Style="{StaticResource BadgeText}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Настройки"
                                   Style="{StaticResource PageHeaderTitle}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Управляйте внешним видом, данными и параметрами приложения"
                                   Style="{StaticResource BodyTextLarge}"/>
                    </StackPanel>

                    <Border Background="{DynamicResource BgSurfaceGlass}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusLg}"
                            Padding="24,28"
                            Margin="0,0,0,16">

                        <StackPanel>
                            <DockPanel LastChildFill="True"
                                       Margin="0,0,0,4">
                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="{DynamicResource CornerRadiusFull}"
                                        Background="{DynamicResource BgHover}"
                                        Margin="0,0,14,0"
                                        DockPanel.Dock="Left">
                                    <Viewbox Width="20"
                                             Height="20"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Path Data="M12 2v2 M12 20v2 M2 12h2 M20 12h2 M4.93 4.93l1.41 1.41 M17.66 17.66l1.41 1.41 M4.93 19.07l1.41-1.41 M17.66 6.34l1.41-1.41 M12 7a5 5 0 100 10 5 5 0 000-10z"
                                                  Stroke="{DynamicResource TextPrimary}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <StackPanel>
                                    <TextBlock Text="Внешний вид"
                                               Style="{StaticResource Heading4}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Настройте тему, шрифт и цветовую палитру"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Тема"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Выберите светлую или тёмную тему"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">

                                    <RadioButton x:Name="DarkThemeBtn"
                                                 Margin="0,0,6,0"
                                                 Height="40"
                                                 Padding="20,10"
                                                 Style="{StaticResource ThemeRadioButton}"
                                                 Checked="DarkThemeBtn_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="20"
                                                     Height="20"
                                                     Margin="0,0,10,0">
                                                <Canvas Width="24"
                                                        Height="24">
                                                    <Path Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Тёмная"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeSm}"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="LightThemeBtn"
                                                 Height="40"
                                                 Padding="20,10"
                                                 Style="{StaticResource ThemeRadioButton}"
                                                 Checked="LightThemeBtn_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="20"
                                                     Height="20"
                                                     Margin="0,0,10,0">
                                                <Canvas Width="24"
                                                        Height="24">
                                                    <Path Data="M12 2v2 M12 20v2 M2 12h2 M20 12h2 M4.93 4.93l1.41 1.41 M17.66 17.66l1.41 1.41 M4.93 19.07l1.41-1.41 M17.66 6.34l1.41-1.41 M12 7a5 5 0 100 10 5 5 0 000-10z"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Светлая"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeSm}"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Размер шрифта"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Увеличьте или уменьшите текст"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Slider x:Name="FontSizeSlider"
                                            Style="{StaticResource FontSizeSlider}"
                                            ValueChanged="FontSizeSlider_ValueChanged"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Цветовая палитра"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Выберите основную цветовую гамму приложения"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">

                                    <RadioButton x:Name="PaletteDefault"
                                                 Style="{StaticResource PaletteRadioButton}"
                                                 IsChecked="True"
                                                 Click="PaletteDefault_Click">
                                        <Border Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                BorderThickness="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0"
                                                                      EndPoint="1,1">
                                                    <GradientStop Color="#8CA2F1"
                                                                  Offset="0"/>
                                                    <GradientStop Color="#B293DB"
                                                                  Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </RadioButton>

                                    <RadioButton x:Name="PaletteOcean"
                                                 Style="{StaticResource PaletteRadioButton}"
                                                 Click="PaletteOcean_Click">
                                        <Border Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                BorderThickness="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0"
                                                                      EndPoint="1,1">
                                                    <GradientStop Color="#1A73E8"
                                                                  Offset="0"/>
                                                    <GradientStop Color="#00BCD4"
                                                                  Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </RadioButton>

                                    <RadioButton x:Name="PaletteSunset"
                                                 Style="{StaticResource PaletteRadioButton}"
                                                 Click="PaletteSunset_Click">
                                        <Border Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                BorderThickness="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0"
                                                                      EndPoint="1,1">
                                                    <GradientStop Color="#FF6B35"
                                                                  Offset="0"/>
                                                    <GradientStop Color="#FFB74D"
                                                                  Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </RadioButton>

                                    <RadioButton x:Name="PaletteEmber"
                                                 Style="{StaticResource PaletteRadioButton}"
                                                 Click="PaletteEmber_Click">
                                        <Border Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                BorderThickness="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0"
                                                                      EndPoint="1,1">
                                                    <GradientStop Color="#FF1744"
                                                                  Offset="0"/>
                                                    <GradientStop Color="#FF6D00"
                                                                  Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </RadioButton>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Положение окна урока"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Выберите угол экрана для окна с инструкциями"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button Content="Верхний левый"
                                            Style="{StaticResource SecondaryButtonSmall}"
                                            FontSize="{DynamicResource FontSizeSm}"
                                            Padding="15,4"
                                            Margin="0,0,4,0"/>
                                    <Button Content="Верхний правый"
                                            Style="{StaticResource PrimaryButtonSmall}"
                                            FontSize="{DynamicResource FontSizeSm}"
                                            Padding="15,4"
                                            Margin="0,0,4,0"/>
                                    <Button Content="Нижний левый"
                                            Style="{StaticResource SecondaryButtonSmall}"
                                            FontSize="{DynamicResource FontSizeSm}"
                                            Padding="15,4"
                                            Margin="0,0,4,0"/>
                                    <Button Content="Нижний правый"
                                            Style="{StaticResource SecondaryButtonSmall}"
                                            FontSize="{DynamicResource FontSizeSm}"
                                            Padding="15,4"
                                            Margin="0,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgSurfaceGlass}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusLg}"
                            Padding="24,28"
                            Margin="0,0,0,16">

                        <StackPanel>
                            <DockPanel LastChildFill="True"
                                       Margin="0,0,0,4">
                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="{DynamicResource CornerRadiusFull}"
                                        Background="{DynamicResource BgHover}"
                                        Margin="0,0,14,0"
                                        DockPanel.Dock="Left">
                                    <Viewbox Width="20"
                                             Height="20"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Path Data="M18 8C18 6.4087 17.3679 4.88258 16.2426 3.75736C15.1174 2.63214 13.5913 2 12 2C10.4087 2 8.88258 2.63214 7.75736 3.75736C6.63214 4.88258 6 6.4087 6 8C6 15 3 17 3 17H21C21 17 18 15 18 8Z"
                                                  Stroke="{DynamicResource TextPrimary}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                            <Path Data="M13.73 21C13.5542 21.3031 13.3019 21.5547 12.9982 21.7295C12.6946 21.9044 12.3504 21.9965 12 21.9965C11.6496 21.9965 11.3054 21.9044 11.0018 21.7295C10.6982 21.5547 10.4458 21.3031 10.27 21"
                                                  Stroke="{DynamicResource TextPrimary}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <StackPanel>
                                    <TextBlock Text="Уведомления"
                                               Style="{StaticResource Heading4}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Управляйте системными напоминаниями"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Ежедневные напоминания"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Получайте напоминания о необходимости учиться"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <ToggleButton x:Name="DailyRemindersToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="True"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Прогресс за неделю"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Еженедельный отчёт о прогрессе"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <ToggleButton x:Name="WeeklyReportToggle"
                                                  Style="{StaticResource ToggleSwitch}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Новые уроки"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Уведомления о добавлении новых уроков"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <ToggleButton x:Name="NewLessonsToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="True"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgSurfaceGlass}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusLg}"
                            Padding="24,28"
                            Margin="0,0,0,16">

                        <StackPanel>
                            <DockPanel LastChildFill="True"
                                       Margin="0,0,0,4">
                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="{DynamicResource CornerRadiusFull}"
                                        Background="{DynamicResource BgHover}"
                                        Margin="0,0,14,0"
                                        DockPanel.Dock="Left">
                                    <Viewbox Width="20"
                                             Height="20"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Path Data="M4 4v16h16V4H4z M8 9h8M8 15h6"
                                                  Stroke="{DynamicResource TextPrimary}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <StackPanel>
                                    <TextBlock Text="Данные"
                                               Style="{StaticResource Heading4}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Экспорт, импорт, сброс прогресса"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Экспорт данных"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Сохраните прогресс в файл"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="ExportBtn"
                                            Style="{StaticResource SecondaryButtonSmall}"
                                            FontSize="{DynamicResource FontSizeSm}"
                                            Padding="20,4"
                                            Click="ExportBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16"
                                                     Height="16"
                                                     Margin="0,0,8,0">
                                                <Canvas Width="24"
                                                        Height="24">
                                                    <Path Data="M12 16V4M8 12l4 4 4-4 M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Экспорт"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Импорт данных"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Восстановите прогресс из файла"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="ImportBtn"
                                            Style="{StaticResource SecondaryButtonSmall}"
                                            FontSize="{DynamicResource FontSizeSm}"
                                            Padding="20,4"
                                            Click="ImportBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16"
                                                     Height="16"
                                                     Margin="0,0,8,0">
                                                <Canvas Width="24"
                                                        Height="24">
                                                    <Path Data="M12 4v12M8 12l4 4 4-4 M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Импорт"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Сбросить прогресс"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Удалить все данные об обучении"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="ResetProgressBtn"
                                            Style="{StaticResource DangerButton}"
                                            FontSize="{DynamicResource FontSizeSm}"
                                            Padding="20,4"
                                            Click="ResetProgressBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16"
                                                     Height="16"
                                                     Margin="0,0,8,0">
                                                <Canvas Width="24"
                                                        Height="24">
                                                    <Path Data="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2 M10 11v6M14 11v6"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Сбросить"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Сбросить настройки"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Вернуть настройки к значениям по умолчанию"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="ResetSettingsBtn"
                                            Style="{StaticResource DangerButton}"
                                            FontSize="{DynamicResource FontSizeSm}"
                                            Padding="20,4"
                                            Click="ResetSettingsBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16"
                                                     Height="16"
                                                     Margin="0,0,8,0">
                                                <Canvas Width="24"
                                                        Height="24">
                                                    <Path Data="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Сбросить"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgSurfaceGlass}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusLg}"
                            Padding="24,28"
                            Margin="0,0,0,16">

                        <StackPanel>
                            <DockPanel LastChildFill="True"
                                       Margin="0,0,0,4">
                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="{DynamicResource CornerRadiusFull}"
                                        Background="{DynamicResource BgHover}"
                                        Margin="0,0,14,0"
                                        DockPanel.Dock="Left">
                                    <Viewbox Width="20"
                                             Height="20"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Path Data="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"
                                                  Stroke="{DynamicResource TextPrimary}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <StackPanel>
                                    <TextBlock Text="Обратная связь"
                                               Style="{StaticResource Heading4}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Отзывы, ошибки, предложения и FAQ"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Написать нам"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Сообщите о проблеме или поделитесь идеей"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="FeedbackBtn"
                                            Style="{StaticResource PrimaryButton}"
                                            FontSize="{DynamicResource FontSizeSm}"
                                            Padding="30,4"
                                            Click="FeedbackBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16"
                                                     Height="16"
                                                     Margin="0,0,8,0">
                                                <Canvas Width="24"
                                                        Height="24">
                                                    <Path Data="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Отправить сообщение"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="52">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Часто задаваемые вопросы"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Ответы на популярные вопросы"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="FaqBtn"
                                            Style="{StaticResource SecondaryButtonSmall}"
                                            FontSize="{DynamicResource FontSizeSm}"
                                            Padding="20,4"
                                            Click="FaqBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16"
                                                     Height="16"
                                                     Margin="0,0,8,0">
                                                <Canvas Width="24"
                                                        Height="24">
                                                    <Path Data="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3 M12 17h.01"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Открыть FAQ"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgSurfaceGlass}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusLg}"
                            Padding="24,28"
                            Margin="0,0,0,0">

                        <StackPanel>
                            <DockPanel LastChildFill="True"
                                       Margin="0,0,0,4">
                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="{DynamicResource CornerRadiusFull}"
                                        Background="{DynamicResource BgHover}"
                                        Margin="0,0,14,0"
                                        DockPanel.Dock="Left">
                                    <Viewbox Width="20"
                                             Height="20"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Canvas Width="24"
                                                Height="24">
                                            <Path Data="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                                  Stroke="{DynamicResource TextPrimary}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <StackPanel>
                                    <TextBlock Text="О приложении"
                                               Style="{StaticResource Heading4}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="Версия, разработчики, данные"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtle}"
                                    Margin="0,15,0,15"/>

                            <DockPanel LastChildFill="True"
                                       Height="40">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Версия"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="1.0.0 Beta"
                                               Style="{StaticResource BodyTextSmall}"
                                               FontFamily="{StaticResource FontMono}"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel LastChildFill="True"
                                       Height="40">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Разработчик"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="DigitalEducation Team"
                                               Style="{StaticResource BodyTextSmall}"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel LastChildFill="True"
                                       Height="40">
                                <StackPanel DockPanel.Dock="Left"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Данные"
                                               Style="{StaticResource SettingTitle}"
                                               Margin="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock x:Name="SettingsPathText"
                                               Text="%LocalAppData%/DigitalEducation/settings.json"
                                               Style="{StaticResource BodyTextSmall}"
                                               FontFamily="{StaticResource FontMono}"
                                               Foreground="{DynamicResource TextTertiary}"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="© 2026 DigitalEducation • версия 2.0"
                               Style="{StaticResource CaptionSmall}"
                               Margin="0,30,0,28"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextTertiary}"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="Overlay"
                Background="#000000"
                Opacity="0"
                Visibility="Collapsed"
                Panel.ZIndex="50"/>

        <Grid x:Name="SidebarContainer"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Width="300"
              Margin="-300,0,0,0"
              Panel.ZIndex="60">
            <components:Sidebar x:Name="SidebarControl"
                                CurrentPage="settings"/>
        </Grid>

        <Button x:Name="MenuToggle"
                Style="{StaticResource MenuToggleStyle}"/>

        <components:Modal x:Name="ModalWindow"
                          Panel.ZIndex="1000"/>
    </Grid>
</Window>
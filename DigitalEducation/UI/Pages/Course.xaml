<Window x:Class="DigitalEducation.UI.Pages.Course"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:DigitalEducation.UI.Components"
        mc:Ignorable="d"
        Title="DigitalEducation — Курс"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Height="1080"
        Width="1920">

    <Grid>
        <components:Background x:Name="BackgroundControl"/>

        <Grid x:Name="ContentContainer">
            <Grid.Effect>
                <BlurEffect x:Name="ContentBlur"
                            Radius="0"
                            KernelType="Gaussian"/>
            </Grid.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Margin="400,0,400,0">

                <StackPanel Margin="0,100,0,0">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,32">
                        <Button Content="Курсы"
                                Style="{StaticResource LinkButton}"
                                Click="BackToCourses_Click"
                                FontSize="{DynamicResource FontSizeSm}"
                                Foreground="{DynamicResource Accent1}"
                                Cursor="Hand"
                                Padding="0"
                                Height="Auto"
                                MinHeight="0"
                                MinWidth="0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="/"
                                   Foreground="{DynamicResource TextTertiary}"
                                   Margin="8,0,8,0"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeSm}"/>
                        <TextBlock x:Name="BreadcrumbTitle"
                                   Text="Название курса"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeSm}"/>
                    </StackPanel>

                    <Border Background="{DynamicResource BgSurfaceGlass}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusLg}"
                            Padding="30,28"
                            Margin="0,0,0,32">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="80"
                                    Height="80"
                                    CornerRadius="{DynamicResource CornerRadiusLg}"
                                    Background="{DynamicResource GradientPrimary}"
                                    Margin="0,0,24,0">
                                <Viewbox Margin="20">
                                    <Canvas Width="24"
                                            Height="24">
                                        <Path x:Name="CourseIconPath"
                                              Stroke="White"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="CourseTitle"
                                           Text="Название курса"
                                           Style="{StaticResource PageHeaderTitle}"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="CourseDescription"
                                           Text="Описание курса"
                                           Style="{StaticResource BodyTextLarge}"
                                           Margin="0,0,0,12"
                                           TextWrapping="Wrap"/>

                                <WrapPanel>
                                    <Border Background="{DynamicResource BgHover}"
                                            CornerRadius="{DynamicResource CornerRadiusFull}"
                                            Padding="12,4,12,4"
                                            Margin="0,0,12,4">
                                        <TextBlock x:Name="CourseLevel"
                                                   Text="Уровень"
                                                   Style="{StaticResource CaptionSmall}"/>
                                    </Border>
                                    <Border Background="{DynamicResource BgHover}"
                                            CornerRadius="{DynamicResource CornerRadiusFull}"
                                            Padding="12,4,12,4"
                                            Margin="0,0,12,4">
                                        <TextBlock x:Name="CourseTime"
                                                   Text="Время"
                                                   Style="{StaticResource CaptionSmall}"/>
                                    </Border>
                                    <Border Background="{DynamicResource BgHover}"
                                            CornerRadius="{DynamicResource CornerRadiusFull}"
                                            Padding="12,4,12,4"
                                            Margin="0,0,12,4">
                                        <TextBlock x:Name="CourseLessonsCount"
                                                   Text="0 уроков"
                                                   Style="{StaticResource CaptionSmall}"/>
                                    </Border>
                                    <Border Background="{DynamicResource BgHover}"
                                            CornerRadius="{DynamicResource CornerRadiusFull}"
                                            Padding="12,4,12,4">
                                        <TextBlock x:Name="CourseProgressText"
                                                   Text="0% завершено"
                                                   Style="{StaticResource CaptionSmall}"
                                                   Foreground="{DynamicResource Accent1}"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource BgSurfaceGlass}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusLg}"
                            Padding="30,25"
                            Margin="0,0,0,32">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,24,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Прогресс курса"
                                           Style="{StaticResource BodyTextSmall}"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="ProgressStats"
                                           Text="0 из 0 уроков"
                                           Style="{StaticResource Heading4}"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <ProgressBar x:Name="CourseProgressBar"
                                             Style="{StaticResource ProgressBarLarge}"
                                             Value="0"
                                             Maximum="100"
                                             Height="6"
                                             Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProgressPercent"
                                               Grid.Column="0"
                                               Text="0%"
                                               Style="{StaticResource BodyTextSmall}"/>
                                    <TextBlock x:Name="ProgressTime"
                                               Grid.Column="1"
                                               Text="0 мин"
                                               Style="{StaticResource BodyTextSmall}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Уроки курса"
                                   Style="{StaticResource Heading4}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Выберите урок для начала обучения"
                                   Style="{StaticResource BodyTextSmall}"/>
                    </StackPanel>

                    <StackPanel x:Name="LessonsList"
                                Margin="0,0,0,40"/>

                    <Border x:Name="EmptyState"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,0,0,40">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="48,20">

                            <Viewbox Width="48"
                                     Height="48"
                                     Margin="0,0,0,12"
                                     Opacity="0.5">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Data="M12 2v4M12 22v-4M4 12H2M22 12h-2M19.07 4.93l-2.83 2.83M4.93 19.07l2.83-2.83M4.93 4.93l2.83 2.83M19.07 19.07l-2.83-2.83"
                                          Stroke="{DynamicResource TextTertiary}"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="В этом курсе пока нет уроков"
                                       Style="{StaticResource BodyText}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="© 2026 DigitalEducation • версия 2.0"
                               Style="{StaticResource CaptionSmall}"
                               Margin="0,30,0,28"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextTertiary}"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="Overlay"
                Background="#000000"
                Opacity="0"
                Visibility="Collapsed"
                Panel.ZIndex="50"/>

        <Grid x:Name="SidebarContainer"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Width="300"
              Margin="-300,0,0,0"
              Panel.ZIndex="60">
            <components:Sidebar x:Name="SidebarControl"
                                CurrentPage="courses"/>
        </Grid>

        <Button x:Name="MenuToggle"
                Style="{StaticResource MenuToggleStyle}"/>

        <components:Modal x:Name="ModalWindow"
                          Panel.ZIndex="1000"/>
    </Grid>
</Window>
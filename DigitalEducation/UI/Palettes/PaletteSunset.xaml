<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Accent1" Color="#FF6B35"/>
    <SolidColorBrush x:Key="Accent2" Color="#FFB74D"/>
    <SolidColorBrush x:Key="Accent3" Color="#FFD93D"/>
    <SolidColorBrush x:Key="AccentGlow" Color="#FFB74D"/>

    <Color x:Key="Accent1Color">#FF6B35</Color>
    <Color x:Key="Accent2Color">#FFB74D</Color>
    <Color x:Key="Accent3Color">#FFD93D</Color>
    <Color x:Key="AccentGlowColor">#FFB74D</Color>

    <LinearGradientBrush x:Key="GradientPrimary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6B35" Offset="0"/>
        <GradientStop Color="#FFB74D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientSecondary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD93D" Offset="0"/>
        <GradientStop Color="#FFB74D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientAccent" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF6B35" Offset="0"/>
        <GradientStop Color="#FFB74D" Offset="0.5"/>
        <GradientStop Color="#FFD93D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientProgress" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF6B35" Offset="0"/>
        <GradientStop Color="#FFB74D" Offset="0.5"/>
        <GradientStop Color="#FFD93D" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
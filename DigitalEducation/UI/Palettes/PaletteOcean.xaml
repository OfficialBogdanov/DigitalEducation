<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Accent1" Color="#1A73E8"/>
    <SolidColorBrush x:Key="Accent2" Color="#00BCD4"/>
    <SolidColorBrush x:Key="Accent3" Color="#4CAF50"/>
    <SolidColorBrush x:Key="AccentGlow" Color="#00BCD4"/>

    <Color x:Key="Accent1Color">#1A73E8</Color>
    <Color x:Key="Accent2Color">#00BCD4</Color>
    <Color x:Key="Accent3Color">#4CAF50</Color>
    <Color x:Key="AccentGlowColor">#00BCD4</Color>

    <LinearGradientBrush x:Key="GradientPrimary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A73E8" Offset="0"/>
        <GradientStop Color="#00BCD4" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientSecondary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4CAF50" Offset="0"/>
        <GradientStop Color="#00BCD4" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientAccent" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A73E8" Offset="0"/>
        <GradientStop Color="#00BCD4" Offset="0.5"/>
        <GradientStop Color="#4CAF50" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientProgress" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A73E8" Offset="0"/>
        <GradientStop Color="#00BCD4" Offset="0.5"/>
        <GradientStop Color="#4CAF50" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
<UserControl x:Class="DigitalEducation.UI.Components.Modal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="250"
             d:DesignWidth="600"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid SnapsToDevicePixels="True"
          UseLayoutRounding="True">
        <Border x:Name="Overlay"
                Background="#000000"
                Opacity="0"
                Visibility="Collapsed"
                Panel.ZIndex="50"/>

        <Grid x:Name="ModalContainer"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Panel.ZIndex="51"
              Opacity="0"
              Visibility="Collapsed"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">

            <Border x:Name="ModalBox"
                    Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusXl}"
                    Padding="32"
                    MaxWidth="560"
                    MinWidth="480"
                    Width="Auto"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.5"
                                      BlurRadius="24"
                                      Direction="270"
                                      ShadowDepth="8"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ModalScale"
                                        ScaleX="0.95"
                                        ScaleY="0.95"/>
                        <TranslateTransform x:Name="ModalTranslate"
                                            Y="20"/>
                    </TransformGroup>
                </Border.RenderTransform>

                <DockPanel LastChildFill="True"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True">

                    <Border DockPanel.Dock="Top"
                            Margin="0,0,0,16"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TitleText"
                                       Grid.Column="0"
                                       Text="Подтверждение"
                                       Style="{StaticResource Heading4}"
                                       VerticalAlignment="Center"
                                       SnapsToDevicePixels="True"
                                       UseLayoutRounding="True"/>

                            <Button x:Name="CloseButton"
                                    Grid.Column="1"
                                    Style="{StaticResource IconButtonSmall}"
                                    Click="CloseButton_Click">
                                <Viewbox Width="14"
                                         Height="14">
                                    <Canvas>
                                        <Line X1="0"
                                              Y1="0"
                                              X2="24"
                                              Y2="24"
                                              Stroke="{DynamicResource TextTertiary}"
                                              StrokeThickness="2"/>
                                        <Line X1="24"
                                              Y1="0"
                                              X2="0"
                                              Y2="24"
                                              Stroke="{DynamicResource TextTertiary}"
                                              StrokeThickness="2"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="BodyText"
                               DockPanel.Dock="Top"
                               Margin="0,0,0,24"
                               Text="Вы уверены?"
                               Style="{StaticResource BodyText}"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"/>

                    <Border DockPanel.Dock="Bottom"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <StackPanel x:Name="FooterPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,0"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">

                            <Button x:Name="CancelButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,12,0"
                                    Click="CancelButton_Click">
                                <TextBlock Text="Отмена"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Caption}"/>
                            </Button>

                            <Button x:Name="ConfirmButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="ConfirmButton_Click">
                                <TextBlock Text="OK"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextInverse}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
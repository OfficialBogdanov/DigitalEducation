<UserControl x:Class="DigitalEducation.UI.Components.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="300">

    <Border Background="{DynamicResource BgSurface}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="0,0,1,0"
            Width="300">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="24,40,24,20"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            CornerRadius="{DynamicResource CornerRadiusLg}"
                            Background="{DynamicResource GradientPrimary}"
                            Cursor="Hand"
                            MouseLeftButtonDown="Logo_Click">
                        <Viewbox Margin="10">
                            <Canvas Width="24"
                                    Height="24">
                                <Path Stroke="White"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round">
                                    <Path.Data>
                                        <PathGeometry Figures="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="DigitalEducation"
                                   Style="{StaticResource Heading4}"
                                   Foreground="{DynamicResource GradientAccent}"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="Logo_Click"
                                   Width="205"/>
                        <TextBlock Text="цифровая грамотность"
                                   Style="{StaticResource CaptionSmall}"
                                   Width="205"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,4,0,8">
                <StackPanel>
                    <Button x:Name="NavHome"
                            Style="{StaticResource SidebarNavItem}"
                            Tag="False"
                            Click="NavItem_Click"
                            DataContext="home">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0"
                                     Width="24"
                                     Height="24">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path x:Name="HomePath"
                                          Style="{StaticResource SidebarNavIcon}"
                                          Stroke="{DynamicResource TextSecondary}">
                                        <Path.Data>
                                            <PathGeometry Figures="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <TextBlock x:Name="HomeText"
                                       Grid.Column="2"
                                       Text="Главная"
                                       Style="{StaticResource SidebarNavText}"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NavCourses"
                            Style="{StaticResource SidebarNavItem}"
                            Tag="False"
                            Click="NavItem_Click"
                            DataContext="courses">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0"
                                     Width="24"
                                     Height="24">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path x:Name="CoursesPath"
                                          Style="{StaticResource SidebarNavIcon}">
                                        <Path.Data>
                                            <PathGeometry Figures="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <TextBlock x:Name="CoursesText"
                                       Grid.Column="2"
                                       Text="Курсы"
                                       Style="{StaticResource SidebarNavText}"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NavConstructor"
                            Style="{StaticResource SidebarNavItem}"
                            Tag="False"
                            Click="NavItem_Click"
                            DataContext="constructor">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0"
                                     Width="24"
                                     Height="24">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path x:Name="ConstructorPath"
                                          Style="{StaticResource SidebarNavIcon}">
                                        <Path.Data>
                                            <PathGeometry Figures="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z M9 12a3 3 0 106 0 3 3 0 00-6 0z"/>
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <TextBlock x:Name="ConstructorText"
                                       Grid.Column="2"
                                       Text="Конструктор"
                                       Style="{StaticResource SidebarNavText}"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NavProgress"
                            Style="{StaticResource SidebarNavItem}"
                            Tag="False"
                            Click="NavItem_Click"
                            DataContext="progress">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0"
                                     Width="24"
                                     Height="24">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path x:Name="ProgressPath"
                                          Style="{StaticResource SidebarNavIcon}">
                                        <Path.Data>
                                            <PathGeometry Figures="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <TextBlock x:Name="ProgressText"
                                       Grid.Column="2"
                                       Text="Прогресс"
                                       Style="{StaticResource SidebarNavText}"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NavAchievements"
                            Style="{StaticResource SidebarNavItem}"
                            Tag="False"
                            Click="NavItem_Click"
                            DataContext="achievements">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0"
                                     Width="24"
                                     Height="24">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path x:Name="AchievementsPath"
                                          Style="{StaticResource SidebarNavIcon}">
                                        <Path.Data>
                                            <PathGeometry Figures="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <TextBlock x:Name="AchievementsText"
                                       Grid.Column="2"
                                       Text="Достижения"
                                       Style="{StaticResource SidebarNavText}"/>
                        </Grid>
                    </Button>

                    <Button x:Name="NavSettings"
                            Style="{StaticResource SidebarNavItem}"
                            Tag="False"
                            Click="NavItem_Click"
                            DataContext="settings">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0"
                                     Width="24"
                                     Height="24">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path x:Name="SettingsPath"
                                          Style="{StaticResource SidebarNavIcon}">
                                        <Path.Data>
                                            <PathGeometry Figures="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>

                            <TextBlock x:Name="SettingsText"
                                       Grid.Column="2"
                                       Text="Настройки"
                                       Style="{StaticResource SidebarNavText}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Height="Auto"
                    Padding="16,8,16,16"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Background="Transparent">
                <Button x:Name="LogoutButton"
                        Style="{StaticResource SidebarLogoutItem}"
                        Tag="False"
                        Click="LogoutButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0"
                                 Width="24"
                                 Height="24">
                            <Canvas Width="24"
                                    Height="24">
                                <Path x:Name="LogoutPath"
                                      Style="{StaticResource SidebarNavIcon}">
                                    <Path.Data>
                                        <PathGeometry Figures="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Viewbox>

                        <TextBlock x:Name="LogoutText"
                                   Grid.Column="2"
                                   Text="Выход"
                                   Style="{StaticResource SidebarNavText}"/>
                    </Grid>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CubicEase x:Key="CubicEaseOut" EasingMode="EaseOut"/>
    <CubicEase x:Key="CubicEaseIn" EasingMode="EaseIn"/>
    <QuadraticEase x:Key="QuadraticEaseOut" EasingMode="EaseOut"/>
    <QuadraticEase x:Key="QuadraticEaseIn" EasingMode="EaseIn"/>
    <ExponentialEase x:Key="ExponentialEaseOut" EasingMode="EaseOut"/>
    <ExponentialEase x:Key="ExponentialEaseIn" EasingMode="EaseIn"/>

    <Storyboard x:Key="FadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0"
                         To="1"
                         Duration="0:0:0.3"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="FadeOut">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1"
                         To="0"
                         Duration="0:0:0.25"
                         EasingFunction="{StaticResource QuadraticEaseIn}"/>
    </Storyboard>

    <Storyboard x:Key="SlideInLeft">
        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                            From="-300,0,0,0"
                            To="0,0,0,0"
                            Duration="0:0:0.3"
                            EasingFunction="{StaticResource CubicEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="SlideOutLeft">
        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                            From="0,0,0,0"
                            To="-300,0,0,0"
                            Duration="0:0:0.3"
                            EasingFunction="{StaticResource CubicEaseIn}"/>
    </Storyboard>

    <Storyboard x:Key="SlideInRight">
        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                            From="300,0,0,0"
                            To="0,0,0,0"
                            Duration="0:0:0.3"
                            EasingFunction="{StaticResource CubicEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="SlideOutRight">
        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                            From="0,0,0,0"
                            To="300,0,0,0"
                            Duration="0:0:0.3"
                            EasingFunction="{StaticResource CubicEaseIn}"/>
    </Storyboard>

    <Storyboard x:Key="SlideUp">
        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                            From="0,20,0,0"
                            To="0,0,0,0"
                            Duration="0:0:0.25"
                            EasingFunction="{StaticResource QuadraticEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="SlideDown">
        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                            From="0,-20,0,0"
                            To="0,0,0,0"
                            Duration="0:0:0.25"
                            EasingFunction="{StaticResource QuadraticEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="ModalOpen">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0"
                         To="1"
                         Duration="0:0:0.3"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                         From="0.95"
                         To="1"
                         Duration="0:0:0.3"
                         EasingFunction="{StaticResource CubicEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                         From="0.95"
                         To="1"
                         Duration="0:0:0.3"
                         EasingFunction="{StaticResource CubicEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                         From="20"
                         To="0"
                         Duration="0:0:0.3"
                         EasingFunction="{StaticResource CubicEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="ModalClose">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1"
                         To="0"
                         Duration="0:0:0.25"
                         EasingFunction="{StaticResource QuadraticEaseIn}"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                         From="1"
                         To="0.95"
                         Duration="0:0:0.25"
                         EasingFunction="{StaticResource CubicEaseIn}"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                         From="1"
                         To="0.95"
                         Duration="0:0:0.25"
                         EasingFunction="{StaticResource CubicEaseIn}"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                         From="0"
                         To="20"
                         Duration="0:0:0.25"
                         EasingFunction="{StaticResource CubicEaseIn}"/>
    </Storyboard>

    <Storyboard x:Key="OverlayFadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0"
                         To="0.5"
                         Duration="0:0:0.3"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="OverlayFadeOut">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.5"
                         To="0"
                         Duration="0:0:0.25"
                         EasingFunction="{StaticResource QuadraticEaseIn}"/>
    </Storyboard>

    <Storyboard x:Key="ContentBlurIn">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)"
                         From="0"
                         To="8"
                         Duration="0:0:0.3"
                         EasingFunction="{StaticResource CubicEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="ContentBlurOut">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)"
                         From="8"
                         To="0"
                         Duration="0:0:0.25"
                         EasingFunction="{StaticResource CubicEaseIn}"/>
    </Storyboard>

    <Storyboard x:Key="ButtonHover">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                         To="-2"
                         Duration="0:0:0.15"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="0.92"
                         Duration="0:0:0.15"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="ButtonUnhover">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                         To="0"
                         Duration="0:0:0.15"
                         EasingFunction="{StaticResource QuadraticEaseIn}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="1"
                         Duration="0:0:0.15"
                         EasingFunction="{StaticResource QuadraticEaseIn}"/>
    </Storyboard>

    <Storyboard x:Key="ButtonPress">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                         To="1"
                         Duration="0:0:0.08"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="0.8"
                         Duration="0:0:0.08"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="ButtonRelease">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                         To="0"
                         Duration="0:0:0.08"
                         EasingFunction="{StaticResource QuadraticEaseIn}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="1"
                         Duration="0:0:0.08"
                         EasingFunction="{StaticResource QuadraticEaseIn}"/>
    </Storyboard>

    <Storyboard x:Key="ToggleSwitchOn">
        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                            From="4,0,0,0"
                            To="24,0,0,0"
                            Duration="0:0:0.2"
                            EasingFunction="{StaticResource QuadraticEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="ToggleSwitchOff">
        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                            From="24,0,0,0"
                            To="4,0,0,0"
                            Duration="0:0:0.2"
                            EasingFunction="{StaticResource QuadraticEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="Pulse">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                         From="1"
                         To="1.05"
                         Duration="0:0:1"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                         From="1"
                         To="1.05"
                         Duration="0:0:1"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="LogoFloat">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                         From="0"
                         To="-6"
                         Duration="0:0:1.2"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="ProgressFill">
        <DoubleAnimation Storyboard.TargetProperty="Width"
                         From="0"
                         To="280"
                         Duration="0:0:2.2"
                         EasingFunction="{StaticResource CubicEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="DotBlink1">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.8"
                         To="1.2"
                         Duration="0:0:0.7"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         BeginTime="0:0:0"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.8"
                         To="1.2"
                         Duration="0:0:0.7"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         BeginTime="0:0:0"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.2"
                         To="1"
                         Duration="0:0:0.7"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         BeginTime="0:0:0"/>
    </Storyboard>

    <Storyboard x:Key="DotBlink2">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.8"
                         To="1.2"
                         Duration="0:0:0.7"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         BeginTime="0:0:0.2"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.8"
                         To="1.2"
                         Duration="0:0:0.7"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         BeginTime="0:0:0.2"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.2"
                         To="1"
                         Duration="0:0:0.7"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         BeginTime="0:0:0.2"/>
    </Storyboard>

    <Storyboard x:Key="DotBlink3">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.8"
                         To="1.2"
                         Duration="0:0:0.7"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         BeginTime="0:0:0.4"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.8"
                         To="1.2"
                         Duration="0:0:0.7"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         BeginTime="0:0:0.4"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.2"
                         To="1"
                         Duration="0:0:0.7"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         BeginTime="0:0:0.4"/>
    </Storyboard>

    <Storyboard x:Key="GlowPulse">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.95"
                         To="1.05"
                         Duration="0:0:1.5"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.95"
                         To="1.05"
                         Duration="0:0:1.5"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.3"
                         To="0.6"
                         Duration="0:0:1.5"
                         RepeatBehavior="Forever"
                         AutoReverse="True"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="Shake">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)">
            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.05" Value="-8"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="8"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-6"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="6"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-4"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="4"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="-2"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="2"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="Spin">
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                         From="0"
                         To="360"
                         Duration="0:0:1"
                         RepeatBehavior="Forever"
                         EasingFunction="{StaticResource QuadraticEaseOut}"/>
    </Storyboard>

</ResourceDictionary>
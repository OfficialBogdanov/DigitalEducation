<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="FontHeading">/UI/Fonts/Ubuntu/Ubuntu-Bold.ttf#Ubuntu Bold</FontFamily>
    <FontFamily x:Key="FontBody">/UI/Fonts/Nunito/Nunito-Regular.ttf#Nunito</FontFamily>
    <FontFamily x:Key="FontBodyMedium">/UI/Fonts/Nunito/Nunito-Medium.ttf#Nunito Medium</FontFamily>
    <FontFamily x:Key="FontBodySemiBold">/UI/Fonts/Nunito/Nunito-SemiBold.ttf#Nunito SemiBold</FontFamily>
    <FontFamily x:Key="FontBodyBold">/UI/Fonts/Nunito/Nunito-Bold.ttf#Nunito Bold</FontFamily>
    <FontFamily x:Key="FontMono">/UI/Fonts/RobotoMono/RobotoMono-Regular.ttf#Roboto Mono</FontFamily>
    <FontFamily x:Key="FontMonoBold">/UI/Fonts/RobotoMono/RobotoMono-Bold.ttf#Roboto Mono Bold</FontFamily>

    <sys:Double x:Key="FontSizeXs">12</sys:Double>
    <sys:Double x:Key="FontSizeSm">14</sys:Double>
    <sys:Double x:Key="FontSizeBase">16</sys:Double>
    <sys:Double x:Key="FontSizeLg">18</sys:Double>
    <sys:Double x:Key="FontSizeXl">20</sys:Double>
    <sys:Double x:Key="FontSize2Xl">24</sys:Double>
    <sys:Double x:Key="FontSize3Xl">30</sys:Double>
    <sys:Double x:Key="FontSize4Xl">36</sys:Double>
    <sys:Double x:Key="FontSize5Xl">44</sys:Double>
    <sys:Double x:Key="FontSize6Xl">54</sys:Double>

    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="Heading1" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize6Xl}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="60"/>
    </Style>

    <Style x:Key="Heading2" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize4Xl}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="44"/>
    </Style>

    <Style x:Key="Heading3" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize2Xl}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Heading4" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeXl}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="PageHeaderTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize5Xl}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="50"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="LineHeight" Value="28"/>
    </Style>

    <Style x:Key="BodyTextSmall" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="BodyTextLarge" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLg}"/>
        <Setter Property="LineHeight" Value="30"/>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>

    <Style x:Key="CaptionSmall" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontBodySemiBold}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent2}"/>
        <Setter Property="Opacity" Value="0.8"/>
    </Style>

    <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontBodySemiBold}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

</ResourceDictionary>
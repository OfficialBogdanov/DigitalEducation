    <Style x:Key="SidebarNavText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontBodyMedium}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SidebarNavIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

</ResourceDictionary>